{
  "name": "plantuml-rs",
  "displayName": "PlantUML (plantuml-rs)",
  "description": "PlantUML preview and Markdown rendering through the plantuml-rs port: .puml previews and ```puml blocks, rendered locally by a wasm build of plantuml-core",
  "version": "0.3.1",
  "publisher": "bjornharrtell",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bjornharrtell/plantuml-rs"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "plantuml",
    "uml",
    "diagram",
    "svg",
    "markdown"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:plantuml",
    "onCommand:plantuml-rs.openPreview",
    "onCommand:plantuml-rs.exportSvg",
    "onLanguage:markdown",
    "onCommand:plantuml-rs.showLog"
  ],
  "contributes": {
    "commands": [
      {
        "command": "plantuml-rs.openPreview",
        "title": "PlantUML: Open Preview",
        "category": "PlantUML"
      },
      {
        "command": "plantuml-rs.exportSvg",
        "title": "PlantUML: Export SVG",
        "category": "PlantUML"
      },
      {
        "command": "plantuml-rs.showLog",
        "title": "PlantUML: Show Log",
        "category": "PlantUML"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "plantuml-rs.openPreview",
          "when": "resourceLangId == plantuml",
          "group": "navigation"
        },
        {
          "command": "plantuml-rs.exportSvg",
          "when": "resourceLangId == plantuml",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "plantuml-rs.openPreview",
          "when": "resourceLangId == plantuml",
          "group": "navigation"
        },
        {
          "command": "plantuml-rs.exportSvg",
          "when": "resourceLangId == plantuml",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "plantuml-rs.openPreview",
          "when": "resourceLangId == plantuml"
        },
        {
          "command": "plantuml-rs.exportSvg",
          "when": "resourceLangId == plantuml"
        }
      ]
    },
    "languages": [
      {
        "id": "plantuml",
        "aliases": [
          "PlantUML",
          "plantuml"
        ],
        "extensions": [
          ".puml",
          ".plantuml",
          ".iuml",
          ".pu"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "markdown.markdownItPlugins": true,
    "grammars": [
      {
        "language": "plantuml",
        "scopeName": "source.plantuml",
        "path": "./syntaxes/plantuml.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "test": "node test/render.test.js && node test/activation.test.js"
  },
  "devDependencies": {
    "markdown-it": "^14.1.0"
  },
  "icon": "icon.png",
  "homepage": "https://github.com/bjornharrtell/plantuml-rs#editors",
  "bugs": {
    "url": "https://github.com/bjornharrtell/plantuml-rs/issues"
  }
}
